# Ansible managed – Nginx reverse proxy for the Django HA demo

upstream django_app {
    # Local Gunicorn only. HAProxy load-balances between the two web nodes.
    server 127.0.0.1:8000 fail_timeout=0;
}

server {
    listen 80 default_server;
    server_name _;

    #client_max_body_size {{ nginx_client_max_body_size | default('20M') }};
    client_max_body_size 20M;

    # Static files served directly by Nginx
    location /static/ {
        alias /opt/django/config/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        alias /opt/django/media/;
    }

    location / {
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host              $http_host;
        proxy_redirect off;
        proxy_pass http://django_app;
    }
}
