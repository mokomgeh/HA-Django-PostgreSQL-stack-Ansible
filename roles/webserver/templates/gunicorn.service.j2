################################################################################
# Gunicorn systemd unit – generated by Ansible
#
# This unit runs the Django WSGI application under Gunicorn.
# All sensitive configuration (database password, etc.) is injected via
# Environment= directives so the values never appear in the application
# source tree itself.
#
# WorkingDirectory points at the synchronized django_app contents.
# The process runs as the unprivileged django user.
################################################################################

[Unit]
Description=Gunicorn daemon for Django HA Demo (myproject)
After=network.target

[Service]
User=django_user
Group=django_user
WorkingDirectory=/opt/django/myproject
Environment=PATH=/opt/django/venv/bin

# ----- Database connection (must point at the database node) -----
Environment="DB_NAME=django_db"
Environment="DB_USER=django_user"
Environment="DB_PASSWORD=django_user"
Environment="DB_HOST=192.168.56.7"
Environment="DB_PORT=5432"

# ----- Django runtime settings -----
Environment="DJANGO_SETTINGS_MODULE=ha_demo.settings"
Environment="DJANGO_DEBUG=False"
Environment="DJANGO_ALLOWED_HOSTS=*"
Environment="TZ=America/Toronto"

# Bind only to localhost – Nginx is the public-facing process
ExecStart=/opt/django/bin/gunicorn \
          --workers 3 \
          --bind 127.0.0.1:8000 \
          --access-logfile /opt/django/logs/gunicorn-access.log \
          --error-logfile  /opt/django/logs/gunicorn-error.log \
          ha_demo.wsgi:application

Restart=always
RestartSec=3

# Hardening options recommended on RHEL/Rocky
PrivateTmp=true
ReadWritePaths=/opt/django
# NoNewPrivileges=true
# PrivateTmp=true
# ProtectSystem=strict
# ProtectHome=true
# ReadWritePaths=/opt/django

[Install]
WantedBy=multi-user.target
