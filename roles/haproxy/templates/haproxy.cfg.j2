################################################################################
# HAProxy configuration – generated by Ansible
#
# Frontend  : accepts public HTTP on port 80
# Backend   : round-robin across the two Django web servers
# Health    : HTTP GET /health/  (Django view that also checks the DB)
# Stats     : http://<lb-ip>:8404/stats
################################################################################

global
    log         127.0.0.1 local2
    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     4000
    user        haproxy
    group       haproxy
    daemon
    stats socket /var/lib/haproxy/stats

defaults
    mode                    http
    log                     global
    option                  httplog
    option                  dontlognull
    option                  http-server-close
    option                  forwardfor       except 127.0.0.0/8
    option                  redispatch
    retries                 3
    timeout http-request    10s
    timeout queue           1m
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 3000

# Public entry point
frontend http-in
    bind *:80
    default_backend django_backends

# The two Django application servers
backend django_backends
    balance     roundrobin

    # Health check: Django /health/ returns 200 only when the DB is reachable
    option      httpchk GET /health/
    http-check  expect status 200

{% for host in groups['webservers'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] | default(host) }}:80 check inter 5s fall 3 rise 2
{% endfor %}


# Built-in statistics page (protect with a strong password in production)
listen stats
    bind *:8404
    stats enable
    stats uri /stats
    stats refresh 10s
    stats auth admin:"admin"
    stats admin if TRUE
